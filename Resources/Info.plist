<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>io.github.sylvainlafitte.plume</string>
    <key>CFBundleName</key>
    <string>Plume</string>
    <key>CFBundleDisplayName</key>
    <string>Plume</string>
    <key>CFBundleExecutable</key>
    <string>plume</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>

    <!-- Menubar-only agent: no Dock icon, no default window.
         Must match setActivationPolicy(.accessory) in App.swift; both are needed. -->
    <key>LSUIElement</key>
    <true/>

    <!-- TCC prompt strings. The bundle carrying these is what gives Plume its own
         responsible-process identity — without it, system audio records digital
         silence with no error. See spikes/responsible-process/RESULTS.md. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Plume records your microphone so your side of a meeting can be transcribed on-device.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Plume records system audio so the other participants can be transcribed on-device.</string>
</dict>
</plist>
